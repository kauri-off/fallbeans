# Fall Beans game server (Rust). Installed as /etc/systemd/system/fallbeans.service by `cargo xtask deploy`.
# UDP 5888 is the game's own port (open in ufw); the WebSocket fallback listens on 127.0.0.1:5889 behind
# nginx (wss://…/fallbeans/ws on TCP 443, see nginx/fallbeans.conf).
[Unit]
Description=Fall Beans game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/fallbeans/current/fb_server --udp-port 5888 --ws-addr 127.0.0.1 --ws-port 5889 --metrics-every 60
Environment=NO_COLOR=1

DynamicUser=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
MemoryMax=300M
TasksMax=64
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
