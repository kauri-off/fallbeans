# Ports 5887/tcp HTTP API, 5888/udp game, 5889/tcp WebSocket; options in /etc/fallbeans/fallbeans.env.
[Unit]
Description=Fall Beans game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/fb_server --metrics-every 60 $FB_ARGS
Environment=NO_COLOR=1
Environment=FB_ARGS=
EnvironmentFile=/etc/fallbeans/fallbeans.env

DynamicUser=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
MemoryMax=300M
TasksMax=64
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
