# Ports 5887/tcp HTTP API, 5888/udp game, 5889/tcp WebSocket; options in /etc/fallbeans/fallbeans.env.
[Unit]
Description=Fall Beans game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/fb_server --metrics-every 60 $FB_ARGS
Environment=NO_COLOR=1
Environment=FB_ARGS=
EnvironmentFile=/etc/fallbeans/fallbeans.env

DynamicUser=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
MemoryMax=300M
# Threads: main, HTTP, 2 WebSocket workers (+ a few blocking), 3 Bevy pools, the signal handler, one per room
# building its next round.
TasksMax=64
# Every WebSocket and HTTP connection is a descriptor (the server caps them: 512 each); the default soft limit
# is 1024.
LimitNOFILE=65536
# Also after the server exits on its own when a transport or the HTTP API stopped (exit code 1).
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
