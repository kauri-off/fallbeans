+std::string WCharToUTF8(const std::wstring& wstr)
+{
+    std::string out;
+    for (wchar_t wc : wstr)
+    {
+        uint32_t c = static_cast<uint32_t>(wc);
+        if (c < 0x80)
+            out += char(c);
+        else if (c < 0x800)
+        {
+            out += char(0xC0 | (c >> 6));
+            out += char(0x80 | (c & 0x3F));
+        }
+        else if (c < 0x10000)
+        {
+            out += char(0xE0 | (c >> 12));
+            out += char(0x80 | ((c >> 6) & 0x3F));
+            out += char(0x80 | (c & 0x3F));
+        }
+        else
+        {
+            out += char(0xF0 | (c >> 18));
+            out += char(0x80 | ((c >> 12) & 0x3F));
+            out += char(0x80 | ((c >> 6) & 0x3F));
+            out += char(0x80 | (c & 0x3F));
+        }
+    }
+    return out;
+}
+
+std::wstring UTF8ToWChar(const std::string& str)
+{
+    std::wstring out;
+    for (size_t i = 0; i < str.size();)
+    {
+        unsigned char b = static_cast<unsigned char>(str[i]);
+        uint32_t c;
+        int n;
+        if (b < 0x80) { c = b; n = 0; }
+        else if ((b >> 5) == 6) { c = b & 0x1F; n = 1; }
+        else if ((b >> 4) == 14) { c = b & 0x0F; n = 2; }
+        else { c = b & 0x07; n = 3; }
+        ++i;
+        for (int k = 0; k < n && i < str.size(); ++k, ++i)
+            c = (c << 6) | (static_cast<unsigned char>(str[i]) & 0x3F);
+        out += static_cast<wchar_t>(c);
+    }
+    return out;
+}
+#endif
