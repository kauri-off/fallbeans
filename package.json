{
  "name": "fall-beans",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun src/server/main.ts",
    "build": "bun scripts/build.ts",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test --project=e2e",
    "visual": "playwright test --project=visual",
    "visual:update": "playwright test --project=visual --update-snapshots",
    "audit": "bun scripts/audit.ts",
    "bench": "bun scripts/bench.ts",
    "bench:client": "bun scripts/bench-client.ts",
    "stress": "bun scripts/stress.ts",
    "trace": "bun scripts/trace.ts",
    "replay": "bun scripts/replay.ts",
    "probe": "bun scripts/probe.ts",
    "assets": "bun scripts/assets.ts",
    "check": "tsc --noEmit && biome check . && vitest run",
    "new-game": "bun scripts/new-game.ts",
    "deploy": "bun scripts/deploy.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "@webtransport-bun/webtransport": "0.3.0",
    "preact": "^10.29.8",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.4.2",
    "@types/three": "^0.186.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
